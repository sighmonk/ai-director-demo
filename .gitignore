# This file is used to ignore files and directories that should not be tracked by Git.

# Godot-specific
.import/
.export/
.godot/

# builds
bin/
obj/
Builds/
*.exe
*.dll
*.pdb
*.mono/
*.mono-temp/
*.csproj.user

# NuGet
packages/

# Test results
TestResults/
*.trx

# GdUnit4 test adapter generated runner
gdunit4_testadapter*/

# VS Code (local settings; keep the example config tracked)
.vscode/*
!.vscode/mcp.example.json

# JetBrains Rider
.idea/

# LaTeX
*.tex
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.pdf

# OS
.DS_Store
Thumbs.db

# Local environment and AI tooling (never commit secrets)
.env
.env.*
!.env.example
addons/godot_mcp/
.ai-game-dev/
.mcp.json
Directory.Build.props
*.csproj.old*

# Private agent instructions (kept local by design)
.github/copilot-instructions.md