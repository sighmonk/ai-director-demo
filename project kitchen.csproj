<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>projectkitchen</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>NU1605</NoWarn>
  </PropertyGroup>
  
  <!-- gdUnit4 package dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc7" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.2.0" />
    <PackageReference Include="gdUnit4.analyzers" Version="1.1.0">
      <PrivateAssets>none</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- GdUnit4 5.1.0-rc7 is compiled against System.Collections.Immutable 9.x on net8.0. -->
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
  </ItemGroup>
</Project>