# Local Godot-MCP configuration. Copy this file to .env and fill in real values.
# Never commit the real .env file; it contains a bearer token.
GODOT_MCP_CONNECTION_MODE=<connection-mode>
GODOT_MCP_HOST=<host:port>
GODOT_MCP_AUTH_OPTION=<auth-option>
GODOT_MCP_TOKEN=<token>

# DeepSeek API for the LLM experiment arms (never commit real keys).
# Tests use a fake client and never read these values.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_INPUT_USD_PER_MTOK=0
DEEPSEEK_OUTPUT_USD_PER_MTOK=0
